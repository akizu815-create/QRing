{
  "name": "qring-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:columns": "node scripts/test-column-publication.cjs && python3 scripts/check-column-migration.py",
    "check:column-export": "python3 scripts/check-column-export.py",
    "report:column-review": "node scripts/column-review-report.cjs",
    "seo:sync": "node scripts/gsc-report.mjs --sync",
    "seo:actions": "python3 -m scripts.seo_ops.cli actions",
    "seo:effects": "python3 -m scripts.seo_ops.cli effects",
    "test:seo-ops": "python3 -m unittest discover -s tests/seo_ops -v",
    "check:column-navigation": "python3 scripts/check-column-navigation.py"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@google-analytics/data": "^6.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
